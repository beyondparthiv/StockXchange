# StockXchange — Next.js web app environment
# Copy to `.env.local` and fill in real values from your Supabase project
# (Supabase Dashboard > Project Settings > API).

# --- Supabase ---------------------------------------------------------
# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only. NEVER expose to the browser. Used for privileged operations
# (e.g. writing game results, admin tasks) in later phases.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Price & News Engine ---------------------------------------------
# Server-side URL the Next API routes use to reach the Python engine.
PRICE_ENGINE_URL=http://localhost:8000

# Public URL if the browser ever needs to call the engine directly.
NEXT_PUBLIC_PRICE_ENGINE_URL=http://localhost:8000
