# Price & News Engine environment
# Copy to `.env` inside price-engine/ and adjust as needed.

# Comma-separated list of browser origins allowed to call the engine via CORS.
# Include your deployed frontend URL in production.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Port uvicorn binds to when using the provided run scripts. Default 8000.
PORT=8000
